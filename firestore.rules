rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Wish validation helper (Pillar 2: Validation Blueprints & Anti-Update-Gap)
    function isValidWish(data) {
      return data.keys().hasAll(['name', 'message', 'recipient', 'createdAt'])
        && data.keys().hasOnly(['name', 'message', 'recipient', 'createdAt', 'photoBase64'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.recipient is string && (data.recipient == 'theresa' || data.recipient == 'therese')
        && data.createdAt == request.time
        && (!('photoBase64' in data) || data.photoBase64 == null || (data.photoBase64 is string && data.photoBase64.size() <= 200000));
    }

    // MATCH wishes subcollection under artifacts (Pillar 3: Path Variable Hardening)
    match /artifacts/{appId}/public/data/wishes/{wishId} {
      // Allow creation by any authenticated user (anonymous login is used)
      allow create: if isSignedIn() && isValidId(appId) && isValidId(wishId) && isValidWish(incoming());
      
      // Allow viewing wishes of Theresa publicly for any signed in client (Pillar 8: Secure List Queries)
      allow read, list: if isSignedIn();
      
      // Prevent deleting or updating other people's wishes for safety
      allow update, delete: if false;
    }

    // Allow connection testing path publicly
    match /test/connection {
      allow read: if true;
    }
  }
}

